{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true, // 禁止隐式any类型
    "composite": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "target": "ES6",
    "module": "ESNext"
  },
  "include": [
    "vite.config.ts"
  ]
}